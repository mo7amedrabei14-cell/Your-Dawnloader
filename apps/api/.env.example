# Local development only. Configure a real OIDC application before launching the API.
DATABASE_URL=postgres://dawn:dev-only-change-me@127.0.0.1:5432/dawnloader
API_BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=info
OIDC_ISSUER=https://identity.example.invalid/
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_AUTHORIZATION_URL=https://identity.example.invalid/authorize
OIDC_TOKEN_URL=https://identity.example.invalid/oauth/token
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/oidc/callback
APP_BASE_URL=http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
